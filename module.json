{
  "id": "schedules",
  "name": "Schedules",
  "version": "2.0.14",
  "description": "Business opening hours, special days and schedule overrides.",
  "agent": {
    "description": "Manages business opening hours, special days, and schedule overrides: query and update weekly schedules, create exceptions, and check whether the business is currently open.",
    "keywords": [
      "schedule",
      "hours",
      "opening",
      "special day",
      "override",
      "business hours",
      "closed"
    ]
  },
  "depends_on": [],
  "permissions": [
    "schedules.view_schedule",
    "schedules.add_schedule",
    "schedules.change_schedule",
    "schedules.delete_schedule",
    "schedules.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "schedules.view_schedule",
      "schedules.add_schedule",
      "schedules.change_schedule",
      "schedules.delete_schedule",
      "schedules.manage_settings"
    ],
    "employee": [
      "schedules.view_schedule"
    ]
  },
  "navigation": [
    {
      "id": "hours",
      "label": "Hours",
      "icon": "time-outline",
      "component": "erp-schedules-hours"
    },
    {
      "id": "special_days",
      "label": "Special Days",
      "icon": "star-outline",
      "component": "erp-schedules-hours"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-schedules-hours"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql"
    ]
  },
  "queries": {
    "schedules.business_hours.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/business_hours_list.sql",
      "list": {
        "sort": [
          "id",
          "day_of_week",
          "open_time",
          "close_time",
          "is_closed",
          "break_start",
          "break_end"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "day_of_week": {
            "op": "eq"
          },
          "open_time": {
            "op": "eq"
          },
          "close_time": {
            "op": "eq"
          },
          "is_closed": {
            "op": "eq"
          },
          "break_start": {
            "op": "eq"
          },
          "break_end": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the business opening and closing hours per day of the week"
      }
    },
    "schedules.special_days.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/special_days_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "date",
          "name",
          "is_closed",
          "open_time",
          "close_time",
          "recurring_yearly",
          "notes"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "date": {
            "op": "range"
          },
          "name": {
            "op": "like"
          },
          "is_closed": {
            "op": "eq"
          },
          "open_time": {
            "op": "eq"
          },
          "close_time": {
            "op": "eq"
          },
          "recurring_yearly": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists special days with exceptional opening hours or closures"
      }
    },
    "schedules.special_days.by_date": {
      "permission": "schedules.view_schedule",
      "sql": "queries/special_days_by_date.sql",
      "ai": {
        "description": "Loads the live special day on a given date, used by the create handler to detect duplicates authoritatively (runtime reads)"
      }
    },
    "schedules.overrides.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/overrides_list.sql",
      "list": {
        "sort": [
          "id",
          "start_date",
          "end_date",
          "reason",
          "open_time",
          "close_time",
          "is_closed"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "start_date": {
            "op": "range"
          },
          "end_date": {
            "op": "range"
          },
          "reason": {
            "op": "like"
          },
          "open_time": {
            "op": "eq"
          },
          "close_time": {
            "op": "eq"
          },
          "is_closed": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists one-off schedule overrides for specific dates"
      }
    },
    "schedules.settings.get": {
      "permission": "schedules.view_schedule",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the general settings of the schedules module"
      }
    }
  },
  "commands": {
    "schedules.business_hours.set": {
      "permission": "schedules.change_schedule",
      "schema": "schemas/business_hours_set.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_business_hours"
      },
      "ai": {
        "description": "Sets or updates the business opening hours for each day of the week (the handler validates hours and emits schedules.business_hours.updated)"
      }
    },
    "schedules.special_days.create": {
      "permission": "schedules.add_schedule",
      "schema": "schemas/special_day_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_special_day"
      },
      "reads": [
        {
          "query": "schedules.special_days.by_date",
          "params": {
            "date": "payload.date"
          }
        }
      ],
      "ai": {
        "description": "Creates a special day with exceptional opening hours or a closure (the handler validates hours and emits schedules.special_day.created)"
      }
    },
    "schedules.special_days.delete": {
      "permission": "schedules.delete_schedule",
      "transaction": true,
      "sql": [
        "commands/special_day_delete.sql"
      ],
      "schema": "schemas/special_day_delete.json",
      "emit": [
        "schedules.special_day.deleted"
      ],
      "ai": {
        "description": "Deletes a previously registered special day (destructive)"
      }
    },
    "schedules.overrides.create": {
      "permission": "schedules.add_schedule",
      "schema": "schemas/override_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_override"
      },
      "ai": {
        "description": "Creates a one-off schedule override for a date range (the handler validates the range and, when open, requires open_time/close_time; emits schedules.override.created)"
      }
    },
    "schedules.overrides.delete": {
      "permission": "schedules.delete_schedule",
      "transaction": true,
      "sql": [
        "commands/override_delete.sql"
      ],
      "schema": "schemas/override_delete.json",
      "emit": [
        "schedules.override.deleted"
      ],
      "ai": {
        "description": "Deletes an existing schedule override (destructive)"
      }
    },
    "schedules.settings.save": {
      "permission": "schedules.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_save.sql"
      ],
      "schema": "schemas/settings_save.json",
      "emit": [
        "schedules.settings.saved"
      ],
      "ai": {
        "description": "Saves the general settings of the schedules module"
      }
    },
    "schedules.bulk_create_special_days": {
      "permission": "schedules.add_schedule",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_special_days"
      },
      "ai": {
        "description": "Creates multiple special days in a single bulk operation (fault-tolerant; the handler emits one schedules.special_day.created per created day)"
      }
    },
    "schedules.is_open": {
      "permission": "schedules.view_schedule",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "is_open"
      },
      "ai": {
        "description": "Checks whether the business is open at a given moment according to the configured schedule (pass the rows from schedules.business_hours.list / special_days.list / overrides.list in the payload)"
      }
    },
    "schedules._set_business_hours": {
      "permission": "schedules.change_schedule",
      "sql": [
        "commands/business_hours_set.sql"
      ]
    },
    "schedules._insert_special_day": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/special_day_create.sql"
      ]
    },
    "schedules._insert_special_day_skip": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/_insert_special_day_skip.sql"
      ]
    },
    "schedules._insert_override": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/override_create.sql"
      ]
    }
  },
  "events": {
    "listen": {},
    "emits": [
      "schedules.business_hours.updated",
      "schedules.override.created",
      "schedules.override.deleted",
      "schedules.settings.saved",
      "schedules.special_day.created",
      "schedules.special_day.deleted"
    ]
  },
  "ui": {
    "entry": "dist/schedules.esm.js"
  }
}
