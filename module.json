{
  "id": "schedules",
  "name": "Schedules",
  "version": "2.0.24",
  "description": "Business opening hours, special days and schedule overrides.",
  "agent": {
    "description": "Manages business opening hours, special days, and schedule overrides: query and update weekly schedules, create exceptions, and check whether the business is currently open.",
    "keywords": [
      "schedule",
      "hours",
      "opening",
      "special day",
      "override",
      "business hours",
      "closed"
    ]
  },
  "depends_on": [],
  "permissions": [
    "schedules.view_schedule",
    "schedules.add_schedule",
    "schedules.change_schedule",
    "schedules.delete_schedule",
    "schedules.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "schedules.view_schedule",
      "schedules.add_schedule",
      "schedules.change_schedule",
      "schedules.delete_schedule",
      "schedules.manage_settings"
    ],
    "employee": [
      "schedules.view_schedule"
    ]
  },
  "navigation": [
    {
      "id": "hours",
      "label": "Hours",
      "icon": "time-outline",
      "component": "erp-schedules-hours"
    },
    {
      "id": "special_days",
      "label": "Special Days",
      "icon": "star-outline",
      "component": "erp-schedules-hours"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-schedules-hours"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_business_hours_intervals.sql",
      "migrations/postgres/003_exception_intervals.sql"
    ]
  },
  "queries": {
    "schedules.business_hours.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/business_hours_list.sql",
      "list": {
        "sort": [
          "id",
          "day_of_week",
          "position",
          "open_time",
          "close_time",
          "is_closed",
          "break_start",
          "break_end"
        ],
        "default_sort": "day_of_week",
        "default_dir": "asc",
        "filters": {
          "day_of_week": {
            "op": "eq"
          },
          "open_time": {
            "op": "eq"
          },
          "close_time": {
            "op": "eq"
          },
          "is_closed": {
            "op": "eq"
          },
          "break_start": {
            "op": "eq"
          },
          "break_end": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the business opening intervals per day of the week (several rows per day = split shifts; close_time < open_time = crosses midnight; 00:00–00:00 = open 24 hours; is_closed = 1 closes the day)"
      }
    },
    "schedules.exception_intervals.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/exception_intervals_list.sql",
      "list": {
        "sort": [
          "id",
          "exception_kind",
          "exception_id",
          "position",
          "open_time",
          "close_time"
        ],
        "default_sort": "position",
        "default_dir": "asc",
        "filters": {
          "exception_kind": {
            "op": "eq"
          },
          "exception_id": {
            "op": "eq"
          },
          "position": {
            "op": "eq"
          }
        },
        "page_size": 200
      },
      "ai": {
        "description": "Lists the opening intervals of the exceptions (special days and overrides): several rows for one exception_id = split shift; close_time < open_time = crosses midnight; 00:00-00:00 = open 24 hours. An exception with no row here still carries its own open_time/close_time pair"
      }
    },
    "schedules.special_days.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/special_days_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "date",
          "name",
          "is_closed",
          "open_time",
          "close_time",
          "recurring_yearly",
          "notes"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "date": {
            "op": "range"
          },
          "name": {
            "op": "like"
          },
          "is_closed": {
            "op": "eq"
          },
          "open_time": {
            "op": "eq"
          },
          "close_time": {
            "op": "eq"
          },
          "recurring_yearly": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists special days with exceptional opening hours or closures"
      }
    },
    "schedules.special_days.by_date": {
      "permission": "schedules.view_schedule",
      "sql": "queries/special_days_by_date.sql",
      "ai": {
        "description": "Loads the live special day on a given date, used by the create handler to detect duplicates authoritatively (runtime reads)"
      }
    },
    "schedules.special_days.dates": {
      "permission": "schedules.view_schedule",
      "sql": "queries/special_days_dates.sql"
    },
    "schedules.overrides.list": {
      "permission": "schedules.view_schedule",
      "sql": "queries/overrides_list.sql",
      "list": {
        "search": [
          "reason"
        ],
        "sort": [
          "id",
          "start_date",
          "end_date",
          "reason",
          "open_time",
          "close_time",
          "is_closed"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "start_date": {
            "op": "range"
          },
          "end_date": {
            "op": "range"
          },
          "reason": {
            "op": "like"
          },
          "open_time": {
            "op": "eq"
          },
          "close_time": {
            "op": "eq"
          },
          "is_closed": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists one-off schedule overrides for specific dates"
      }
    },
    "schedules.overrides.overlapping": {
      "permission": "schedules.view_schedule",
      "sql": "queries/overrides_overlapping.sql"
    },
    "schedules.settings.get": {
      "permission": "schedules.view_schedule",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the general settings of the schedules module"
      }
    }
  },
  "commands": {
    "schedules.business_hours.set": {
      "permission": "schedules.change_schedule",
      "schema": "schemas/business_hours_set.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_business_hours"
      },
      "ai": {
        "description": "Replaces the opening intervals of a weekday: pass intervals[] (split shifts, overnight when close < open, 00:00–00:00 for 24 h) or is_closed. The handler validates and sorts them, rejects overlaps and emits schedules.business_hours.updated"
      }
    },
    "schedules.special_days.create": {
      "permission": "schedules.add_schedule",
      "schema": "schemas/special_day_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_special_day"
      },
      "reads": [
        {
          "query": "schedules.special_days.by_date",
          "params": {
            "date": "payload.date"
          }
        }
      ],
      "ai": {
        "description": "Creates a special day with exceptional opening hours or a closure. An open day takes intervals[] (split shifts, overnight when close < open, 00:00-00:00 for 24 h) or the single open_time/close_time pair; the handler validates them, rejects overlaps and emits schedules.special_day.created"
      }
    },
    "schedules.special_days.delete": {
      "permission": "schedules.delete_schedule",
      "transaction": true,
      "sql": [
        "commands/special_day_intervals_delete.sql",
        "commands/special_day_delete.sql"
      ],
      "schema": "schemas/special_day_delete.json",
      "emit": [
        "schedules.special_day.deleted"
      ],
      "ai": {
        "description": "Deletes a previously registered special day and its opening intervals (destructive)"
      }
    },
    "schedules.overrides.create": {
      "permission": "schedules.add_schedule",
      "schema": "schemas/override_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_override"
      },
      "reads": [
        {
          "query": "schedules.overrides.overlapping",
          "params": {
            "start_date": "payload.start_date",
            "end_date": "payload.end_date"
          }
        }
      ],
      "ai": {
        "description": "Creates a one-off schedule override for a date range. An open override takes intervals[] (split shifts, overnight when close < open, 00:00-00:00 for 24 h) or the single open_time/close_time pair — never nothing; the handler validates the range, rejects overlaps with live overrides and between intervals, and emits schedules.override.created"
      }
    },
    "schedules.overrides.delete": {
      "permission": "schedules.delete_schedule",
      "transaction": true,
      "sql": [
        "commands/override_intervals_delete.sql",
        "commands/override_delete.sql"
      ],
      "schema": "schemas/override_delete.json",
      "emit": [
        "schedules.override.deleted"
      ],
      "ai": {
        "description": "Deletes an existing schedule override and its opening intervals (destructive)"
      }
    },
    "schedules.settings.save": {
      "permission": "schedules.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_save.sql"
      ],
      "schema": "schemas/settings_save.json",
      "emit": [
        "schedules.settings.saved"
      ],
      "ai": {
        "description": "Saves the general settings of the schedules module"
      }
    },
    "schedules.bulk_create_special_days": {
      "permission": "schedules.add_schedule",
      "schema": "schemas/bulk_create_special_days.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_special_days"
      },
      "reads": [
        "schedules.special_days.dates"
      ],
      "ai": {
        "description": "Creates multiple special days in a single bulk operation (fault-tolerant; the handler emits one schedules.special_day.created per created day)"
      }
    },
    "schedules.is_open": {
      "permission": "schedules.view_schedule",
      "schema": "schemas/is_open.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "is_open"
      },
      "reads": [
        {
          "query": "schedules.business_hours.list",
          "required": true
        },
        {
          "query": "schedules.special_days.list",
          "required": true
        },
        {
          "query": "schedules.overrides.list",
          "required": true
        },
        {
          "query": "schedules.exception_intervals.list",
          "required": true
        }
      ],
      "ai": {
        "description": "Checks whether the business is open at a given moment. Takes only when (optional): an RFC3339 instant, which is converted to the business timezone, or a bare YYYY-MM-DDTHH:MM, which already is the shop's own wall clock; with no when it answers for right now. The rules are read from the hub itself, never from the payload. Precedence: exact-date special day > yearly recurring special day > override range > weekly intervals > nothing configured. The result says which rule won (source + rule_id), the timezone it was computed in, the local today / current_time, and WHY as a stable code (exception_closed, exception_hours, open_interval, on_break, closed_today, overnight_open, outside_hours, no_hours) with intervals[] (HH:MM-HH:MM spans) to phrase it in the caller language; reason carries only user data (the winning special day name or override reason). Rejections arrive as schedules.* domain error codes"
      }
    },
    "schedules._insert_special_day": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/special_day_create.sql"
      ]
    },
    "schedules._insert_special_day_skip": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/_insert_special_day_skip.sql"
      ]
    },
    "schedules._insert_override": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/override_create.sql"
      ]
    },
    "schedules._insert_exception_interval": {
      "permission": "schedules.add_schedule",
      "sql": [
        "commands/_insert_exception_interval.sql"
      ]
    },
    "schedules._clear_business_hours_day": {
      "permission": "schedules.change_schedule",
      "sql": [
        "commands/_clear_business_hours_day.sql"
      ]
    },
    "schedules._insert_business_hours": {
      "permission": "schedules.change_schedule",
      "sql": [
        "commands/_insert_business_hours.sql"
      ]
    }
  },
  "events": {
    "listen": {},
    "emits": [
      "schedules.business_hours.updated",
      "schedules.override.created",
      "schedules.override.deleted",
      "schedules.settings.saved",
      "schedules.special_day.created",
      "schedules.special_day.deleted"
    ]
  },
  "ui": {
    "entry": "dist/schedules.esm.js"
  }
}
