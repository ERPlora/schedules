{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schedules.bulk_create_special_days",
  "type": "object",
  "additionalProperties": false,
  "required": ["special_days"],
  "properties": {
    "special_days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 366,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "name"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "is_closed": { "type": "boolean", "default": true },
          "open_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": null },
          "close_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": null },
          "recurring_yearly": { "type": "boolean", "default": false },
          "notes": { "type": "string", "default": "" }
        }
      }
    }
  }
}
