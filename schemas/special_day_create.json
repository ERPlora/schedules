{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schedules.special_days.create",
  "description": "Creates a special day (holiday, closure, or a date with different hours). An open day carries 0..N `intervals` (schedules#23: split shift, overnight when close < open, 00:00–00:00 for 24 h); the legacy single open_time/close_time pair is still accepted and becomes the one interval 0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "name"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "is_closed": { "type": "boolean", "default": true },
    "open_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": null },
    "close_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": null },
    "intervals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["open_time", "close_time"],
        "properties": {
          "open_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "close_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        }
      }
    },
    "recurring_yearly": { "type": "boolean", "default": false },
    "notes": { "type": "string", "default": "" }
  }
}
