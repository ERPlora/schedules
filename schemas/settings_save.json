{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schedules.settings.save",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timezone": { "type": "string", "maxLength": 50, "default": "Europe/Madrid", "title": "Zona horaria" },
    "week_starts_on": { "type": "integer", "minimum": 1, "maximum": 7, "default": 1, "title": "Primer día de la semana (1=lunes)" },
    "slot_duration": { "type": "integer", "minimum": 5, "maximum": 120, "default": 30, "title": "Duración del tramo (min)" },
    "auto_close_enabled": { "type": "boolean", "default": false, "title": "Cierre automático de agenda" }
  }
}
